{
  "name": "puppet-plus-ultra",
  "version": "1.0.0",
  "private": false,
  "description": "Plus Ultra Puppet — a cute little drag-anywhere AI puppet with a Deku-style personality, free keyless AI gateways, on-device tool calling, habit learning and zero required API keys.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "start": "node tools/dev-server.mjs",
    "test": "node --test tests/unit/*.test.js",
    "test:system": "node --test tests/system/*.test.js",
    "test:agents": "node tests/run-agents.mjs",
    "test:all": "node tests/run-agents.mjs",
    "test:everything": "npm run lint && npm run test:all",
    "icons": "node tools/make-icons.mjs",
    "lint": "node tools/lint.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.1.3"
  },
  "keywords": [
    "ai",
    "assistant",
    "pwa",
    "deku",
    "tool-calling",
    "on-device",
    "keyless",
    "free-gateways",
    "puppet",
    "mascot"
  ]
}
